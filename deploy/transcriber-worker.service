# Очередь обработки: расшифровка, итог, Word, Telegram.
# Ставится в /etc/systemd/system/ (см. deploy/bootstrap.sh).

[Unit]
Description=Transcriber — очередь обработки звонков
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=transcriber
Group=transcriber
WorkingDirectory=/opt/transcriber
EnvironmentFile=/etc/transcriber.env
Environment=TRANSCRIBER_DATA_DIR=/var/lib/transcriber
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=/opt/transcriber/venv/bin/python -m app.worker
Restart=always
RestartSec=5
# Остановка посреди расшифровки не страшна: готовые куски сохранены,
# после запуска работа продолжится с места обрыва.
TimeoutStopSec=15

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/transcriber

[Install]
WantedBy=multi-user.target
