# Образец настроек. Скопируйте в .env (локально) или в /etc/transcriber.env (сервер)
# и заполните. Сам .env в git не попадает.

# ── Gemini ───────────────────────────────────────────────────────────────
# Ключ из aistudio.google.com (бесплатный уровень, проект без карты)
GEMINI_API_KEY=
# Свой прокси на Cloudflare (cloudflare/gemini-worker.js), если Google блокирует адрес
GEMINI_BASE_URL=
# Необязательно: свой список моделей через запятую
GEMINI_MODEL=

# ── Сайт ─────────────────────────────────────────────────────────────────
TRANSCRIBER_LOGIN=arkprhrv
# Хэш пароля: python tools/set_password.py
TRANSCRIBER_PASSWORD_HASH=
TRANSCRIBER_BASE_URL=https://transcriber.kahman.studio
# Где хранить базу и записи (на сервере — /var/lib/transcriber)
TRANSCRIBER_DATA_DIR=
# 1 — локальный запуск по http://127.0.0.1 (cookie без флага Secure)
TRANSCRIBER_DEV=0
TRANSCRIBER_TZ=Asia/Yekaterinburg
# Имя того, кто ведёт разговор с этого телефона (пусто — модель подпишет по роли)
TRANSCRIBER_OWNER_NAME=
TRANSCRIBER_MAX_UPLOAD_MB=300

# ── Telegram ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Узнать: python -m app.telegram chat-id (сначала напишите боту /start)
TELEGRAM_CHAT_ID=
# Свой Worker на Cloudflare (cloudflare/telegram-worker.js) и его пароль
TELEGRAM_API_BASE=
TELEGRAM_PROXY_SECRET=
